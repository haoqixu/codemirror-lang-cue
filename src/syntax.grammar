@precedence {
    prec_file_attr
    prec_decl_attr
    prec_operand_expr
    prec_clause

    unary @right
    prec7 @left
    prec6 @left
    prec5 @left
    prec4 @left
    prec3 @left
    prec2 @left
    prec1 @left
}

@external propSource cueHighlighting from "./highlight"
// The tokenizer only accepts this at absolute source position zero.
@external tokens fileStart from "./tokens" { bom }
@external tokens numericEllipsis from "./tokens" { postfixDecimal[@name=DecimalLit] }

@top SourceFile {
    bom?
    (Attribute !prec_file_attr comma)*
    (PackageClause comma (Attribute !prec_file_attr comma)*)?
    (ImportDecl comma)*
    (Declaration comma)*
}

@skip { space | Comment }

// Numeric literals
// The external alternative keeps `1...` from being tokenized as `1.` plus `..`.
IntLit     { postfixDecimal | DecimalLit | SiLit | OctalLit | BinaryLit | HexLit }

// String delimiters and contents are context-sensitive (hashes, multiline
// indentation, and nested interpolations). Whitespace inside them is content.
StringLit { SimpleBytesLit | SimpleStringLit ~strlit | MultilineStringLit | MultilineBytesLit }

@skip {} {
    SimpleStringLit    { simpleStringStart stringPart* stringEnd }
    SimpleBytesLit     { simpleBytesStart stringPart* stringEnd }
    MultilineStringLit { multilineStringStart stringPart* stringEnd }
    MultilineBytesLit  { multilineBytesStart stringPart* stringEnd }
    stringPart        { stringContent | Escape | Interpolation }

    // Selectors, imports, and attributes do not allow interpolation.
    SelectorString[@name=SimpleStringLit] { selectorStringStart plainStringPart* stringEnd }
    ImportPath      { importStringStart plainStringPart* stringEnd }
    AttributeString { (simpleStringStart | simpleBytesStart | multilineStringStart | multilineBytesStart)
                      plainStringPart* stringEnd }
    plainStringPart { stringContent | Escape }
}

Interpolation { InterpolationStart Expression insertedComma? InterpolationEnd }

// Values
NullLit { kw<"null"> }
BoolLit { kw<"true"> | kw<"false"> }

// Structs

StructLit       { "{" (Declaration (comma Declaration)* comma?)? "}" }
Declaration     { Field | Ellipsis | Embedding | LetClause | !prec_decl_attr Attribute }
Ellipsis        { "..." Expression? }
Embedding       { Comprehension | AliasExpr ~aliasexpr }
Field           { Label ":" ( Label ":" )* AliasExpr ( Attribute )* }
// Parse both pre-v0.18 prefix aliases and aliasv2 postfix aliases. They use
// separate alternatives so a single label cannot combine the two forms.
Label           {
    ( aliasIdentifier "=" )? LabelExpr |
    PostfixLabelExpr PostfixAlias ( "?" | "!" )? |
    PostfixPatternExpr PostfixAlias
}
LabelExpr       { LabelName ( "?" | "!" )? | "[" AliasExpr ~aliasexpr comma? "]" }
LabelName       { fieldIdentifier ~label-operand | SimpleStringLit ~strlit | "(" ( aliasIdentifier "=" )? Expression ")" ~paren }
PostfixLabelExpr[@name=LabelExpr] { PostfixLabelName }
PostfixPatternExpr[@name=LabelExpr] { "[" Expression ~aliasexpr comma? "]" }
PostfixLabelName[@name=LabelName] {
    fieldIdentifier ~label-operand |
    SimpleStringLit ~strlit |
    "(" Expression ")" ~paren
}
PostfixAlias    { "~" ( aliasIdentifier | "(" aliasIdentifier ( comma aliasIdentifier )? ")" ) }

// Reserved words can name fields/selectors and some can be references or aliases,
// but they are not ordinary binding identifiers (for/let/package/import names).
identifier      { Identifier | BlankIdentifier }
aliasIdentifier { identifier | KeywordIdentifier }
fieldIdentifier { aliasIdentifier | ValueIdentifier }
KeywordIdentifier[@name=Identifier] { kw<"for"> | kw<"if"> | kw<"let"> | kw<"in"> }
ValueIdentifier[@name=Identifier] { kw<"true"> | kw<"false"> | kw<"null"> }
BlankIdentifier[@name=Identifier] { top }
top { @specialize[@name=Top]<Identifier, "_"> }

Attribute       { "@" fieldIdentifier "(" AttrTokens ")" }
AttrTokens      { ( attr_token | AttributeString | insertedComma |
                    "(" AttrTokens ")" |
                    "[" AttrTokens "]" |
                    "{" AttrTokens "}" )* }

// Legacy value aliases have no direct aliasv2 equivalent (`let V = self` is used instead).
AliasExpr  { ( aliasIdentifier "=" )? Expression }

ListLit       { "[" ( ElementList )? "]" }
ElementList   { Ellipsis comma? | Embedding ( comma Embedding )* ( comma Ellipsis )? comma? }

// Predeclared identifiers
// ...

operand     { Literal | OperandName | "(" Expression !prec_operand_expr ")" ~paren }
Literal     { BasicLit | ListLit | StructLit }
BasicLit    { IntLit | FloatLit | StringLit |
              NullLit | BoolLit | BottomLit | top }
OperandName { (Identifier | KeywordIdentifier) ~label-operand }
// QualifiedIdent { PackageName "." Identifier }

// Parse explicitopen syntax unconditionally; version checks belong to the CUE toolchain.
PrimaryExpr {
    operand |
    PrimaryExpr Selector |
    PrimaryExpr Index |
    PrimaryExpr Slice |
    PrimaryExpr Arguments |
    PostfixExpr }
PostfixExpr    { PrimaryExpr "..." }

Selector       { "." (fieldIdentifier | SelectorString) }
Index          { "[" Expression comma? "]" }
Slice          { "[" Expression? ":" Expression? "]" }
Argument       { Expression }
Arguments      { "(" (Argument (comma Argument)* comma?)? ")" }

// https://cuelang.org/docs/reference/spec/#operator-precedence
// Precedence    Operator
//     7             *  /
//     6             +  -
//     5             ==  !=  <  <=  >  >= =~ !~
//     4             &&
//     3             ||
//     2             &
//     1             |

Expression { PrimaryExpr | UnaryExpr | BinExpr }
// Precedence must apply to the recursive expressions, not the operator helpers.
BinExpr {
    Expression !prec1 bitwise_or_op Expression |
    Expression !prec2 bitwise_and_op Expression |
    Expression !prec3 or_op Expression |
    Expression !prec4 and_op Expression |
    Expression !prec5 rel_op Expression |
    Expression !prec6 add_op Expression |
    Expression !prec7 mul_op Expression
}
UnaryExpr  { !unary unary_op _unaryExpr }
_unaryExpr { !unary PrimaryExpr | unary_op _unaryExpr }

bitwise_or_op  { "|" }
bitwise_and_op { "&" }
or_op          { "||" }
and_op         { "&&" }
rel_op         { "==" | "!=" | "<" | "<=" | ">" | ">=" | "=~" | "!~" }
add_op         { "+" | "-" }
mul_op         { "*" | "/" }
unary_op       { "+" | "-" | "!" | "*" | rel_op }

Comprehension       { Clauses StructLit }

Clauses             { StartClause (comma? Clause)* comma? }
StartClause         { ForClause | GuardClause }
Clause              { StartClause | LetClause }
ForClause           { forStart identifier ("," identifier)? kw<"in"> Expression }
GuardClause         { ifStart Expression }
LetClause           { kw<"let"> !prec_clause identifier "=" Expression }

PackageClause  { package PackageName }
PackageName    { identifier }

ImportDecl       { import ( ImportSpec | "(" (ImportSpec (comma ImportSpec)* comma?)? ")" ) }
ImportSpec       { PackageName? ImportPath }

kw<word> { @specialize[@name={word}]<Identifier, word> }

// Unlike other keywords, package/import are ordinary identifiers outside the preamble.
@external specialize {Identifier} preambleKeyword from "./tokens" { package[@name=package], import[@name=import] }

@external tokens strings from "./tokens" {
    simpleStringStart, simpleBytesStart, multilineStringStart, multilineBytesStart,
    importStringStart, selectorStringStart, stringContent, stringEnd, Escape, InterpolationStart, InterpolationEnd
}
@external tokens clauseKeywords from "./tokens" { forStart[@name=for], ifStart[@name=if] }
// Scan whitespace together with commas so a required comma cannot disappear
// just because the current grammar position does not accept it.
@external tokens layout from "./tokens" { insertedComma, space, Comment }
// Unicode category checks and surrogate-pair decoding require an external scanner.
@external tokens identifiers from "./tokens" { Identifier }
@context trackTokens from "./tokens"

comma { "," | insertedComma }

@tokens {
  digit         { $[0-9] }
  decimal_digit { digit }
  binary_digit  { $[0-1] }
  octal_digit   { $[0-7] }
  hex_digit     { $[0-9A-Fa-f] }

  attr_token { ![[\](){}"'#\u{feff}]+ | "#" }

  BottomLit { "_|_" }

  DecimalLit { "0" | $[1-9] ("_"? decimal_digit)* }
  decimals   { decimal_digit ("_"? decimal_digit)* }
  SiLit       { decimals ("." decimals?)? multiplier |
                "." decimals  multiplier }
  BinaryLit  { "0b" "_"? binary_digit ("_"? binary_digit)* }
  HexLit     { "0" ( "x" | "X" ) "_"? hex_digit ( "_"? hex_digit )* }
  OctalLit   { "0o" "_"? octal_digit ( "_"? octal_digit )* }
  multiplier { ( "K" | "M" | "G" | "T" | "P" ) "i"? }

  FloatLit   {
      decimals "." decimals? exponent? |
      decimals exponent |
      "." decimals exponent? }
  exponent   { ( "e" | "E" ) ("+" | "-")? decimals }

  @precedence {
      SiLit, FloatLit, ".", HexLit, BinaryLit, OctalLit, DecimalLit
  }

  "..."[@export=ellipsisToken]
  "?"[@export=optionalMarker]
  "(" ")"[@export=closeParen]
  "{" "}"[@export=closeBrace]
  "[" "]"[@export=closeBracket]
  ":" "," "." "@" "=" "~"
  "+" "-" "*" "/" "!"
  "&&" "||" "|" "&"
  "==" "!=" "<" "<=" ">" ">=" "=~" "!~"

  @precedence {
      attr_token
  }
  
}

@detectDelim
